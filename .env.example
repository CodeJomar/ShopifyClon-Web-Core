# Copiar a .env en local. No poner secretos aquí.
# API Spring. El navegador usa /api (mismo origen); el proxy reenvía a API_INTERNAL_URL + /api/v1.
API_INTERNAL_URL=http://localhost:8080
# Secreto compartido con la API para confiar en X-Forwarded-For (A-002). Mismo valor en la API. Vacío en desarrollo.
API_PROXY_SECRETO=

# Variables para pruebas end-to-end (W-018)
E2E_BASE_URL=
E2E_CORREO=
E2E_CONTRASENA=
